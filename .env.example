# Copia este archivo a .env y ajusta los valores. .env NO se sube a git.

# --- Base de datos ---
POSTGRES_DB=jobtrack
POSTGRES_USER=jobtrack
# Obligatoria. Usa una contraseña larga y aleatoria (p. ej. `openssl rand -base64 24`).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Puerto en 127.0.0.1 para conectar herramientas/desarrollo a la BD (5432 y 5433 suelen estar ocupados por un Postgres local).
DB_HOST_PORT=55432

# --- Aplicación ---
# Puerto donde se publica la aplicación (nginx) en el host.
JOBTRACK_HTTP_PORT=8080
# Interfaz donde se publica la app. 0.0.0.0 en local; 127.0.0.1 si hay un proxy TLS (Caddy) delante.
JOBTRACK_BIND=0.0.0.0
# false en local (http). true cuando se sirva por HTTPS: marca las cookies de sesión y CSRF como Secure.
JOBTRACK_SECURE_COOKIES=false

# --- Solo despliegue en servidor (compose.prod.yaml con Caddy, o compose.traefik.yaml tras un Traefik compartido) ---
# JOBTRACK_DOMAIN=jobtrack.example.com
